# =============================================================================
# VEGA (JARVIS OMEGA) - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For local development, also create .env.local (gitignored) for overrides
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=VEGA
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vega
POSTGRES_USER=vega
POSTGRES_PASSWORD=vega_secure_password

# -----------------------------------------------------------------------------
# REDIS (Caching, Sessions, Celery Broker)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# NEO4J (Knowledge Graph)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vega_graph_password

# -----------------------------------------------------------------------------
# CHROMADB (Vector Embeddings)
# -----------------------------------------------------------------------------
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# -----------------------------------------------------------------------------
# LLM PROVIDERS (At least one required)
# -----------------------------------------------------------------------------

# OpenAI (Cloud) - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Cloud) - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini (Cloud) - Get from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-key-here

# Azure OpenAI (Cloud)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Ollama (Local) - Runs in docker-compose
# No API key needed, uses http://ollama:11434

# vLLM (Local High-Throughput) - Runs in docker-compose with --profile vllm
# No API key needed, uses http://vllm:8000/v1

# Hugging Face (for model downloads)
HF_TOKEN=hf_your-huggingface-token

# -----------------------------------------------------------------------------
# VOICE ENGINE
# -----------------------------------------------------------------------------

# STT: Deepgram (Cloud Streaming) - Get from https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-key

# TTS: ElevenLabs (Premium Cloud) - Get from https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-key

# TTS: Coqui XTTS (Local Voice Cloning) - No API key, runs locally

# TTS: Piper (Fast Local) - No API key, runs locally

# -----------------------------------------------------------------------------
# HOME ASSISTANT (Smart Home / IoT)
# -----------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# -----------------------------------------------------------------------------
# E2B SANDBOX (Secure Code Execution)
# -----------------------------------------------------------------------------
E2B_API_KEY=your-e2b-api-key

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=vega_grafana_password
FLOWER_USER=admin
FLOWER_PASSWORD=vega_flower_password

# -----------------------------------------------------------------------------
# MODEL CONFIGURATION (Optional overrides)
# -----------------------------------------------------------------------------

# Whisper STT Model (tiny, base, small, medium, large, large-v2, large-v3)
WHISPER_MODEL=large-v3
WHISPER_LANG=auto

# YOLOv8 Model (yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt)
YOLO_MODEL=yolov8x.pt

# Face Recognition Model (VGG-Face, Facenet, Facenet512, OpenFace, DeepFace, DeepID, ArcFace, Dlib, SFace, GhostFaceNet)
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface

# OmniParser Model
OMNIPARSER_MODEL=microsoft/OmniParser-v2.0

# vLLM Model (for --profile vllm)
VLLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
VLLM_TENSOR_PARALLEL=1

# -----------------------------------------------------------------------------
# FEATURE FLAGS (true/false)
# -----------------------------------------------------------------------------
ENABLE_VOICE=true
ENABLE_VISION=true
ENABLE_MEMORY=true
ENABLE_PROACTIVE=true
ENABLE_TOOLS=true
ENABLE_PLUGINS=true
ENABLE_SANDBOX=true
ENABLE_MONITORING=true

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-generate-with-openssl-rand-base64-64
JWT_EXPIRATION_MINUTES=10080

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=VEGA